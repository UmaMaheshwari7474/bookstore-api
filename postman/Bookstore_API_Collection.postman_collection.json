{
  "info": {
    "name": "Bookstore API Collection",
    "_postman_id": "c1f7a4e8-87b3-46bc-9c12-3f19e4f5a6b7",
    "description": "Production-ready Postman collection for testing RESTful Bookstore API including CRUD, filtering, pagination, sorting, and error scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authors",
      "item": [
        {
          "name": "Create Author",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.environment.set(\"authorId\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Robert C. Martin\",\n  \"email\": \"unclebob@cleancode.com\",\n  \"biography\": \"American software engineer, co-author of Agile Manifesto and author of Clean Code.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/authors",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authors"]
            }
          }
        },
        {
          "name": "Get All Authors (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/authors?page=0&size=10&sortBy=name&direction=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authors"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sortBy", "value": "name" },
                { "key": "direction", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Get Author by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/authors/{{authorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authors", "{{authorId}}"]
            }
          }
        },
        {
          "name": "Update Author",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Uncle Bob Martin\",\n  \"email\": \"unclebob@cleancode.com\",\n  \"biography\": \"Legendary clean coder and software craftsmanship evangelist.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/authors/{{authorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authors", "{{authorId}}"]
            }
          }
        },
        {
          "name": "Delete Author",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/authors/{{authorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authors", "{{authorId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Books",
      "item": [
        {
          "name": "Create Book",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.environment.set(\"bookId\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Code\",\n  \"isbn\": \"9780132350884\",\n  \"description\": \"A handbook of agile software craftsmanship.\",\n  \"price\": 39.99,\n  \"publishedDate\": \"2008-08-01\",\n  \"genre\": \"Software Engineering\",\n  \"stockQuantity\": 45,\n  \"authorId\": {{authorId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "Get All Books (Default)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}"]
            }
          }
        },
        {
          "name": "Filter Books by Genre and Price",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?genre=Software%20Engineering&minPrice=20.00&maxPrice=50.00",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                { "key": "genre", "value": "Software Engineering" },
                { "key": "minPrice", "value": "20.00" },
                { "key": "maxPrice", "value": "50.00" }
              ]
            }
          }
        },
        {
          "name": "Pagination and Sorting",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?page=0&size=5&sortBy=price&direction=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" },
                { "key": "sortBy", "value": "price" },
                { "key": "direction", "value": "desc" }
              ]
            }
          }
        },
        {
          "name": "Combined Filter, Sort and Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books?title=Clean&page=0&size=5&sortBy=title&direction=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"],
              "query": [
                { "key": "title", "value": "Clean" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" },
                { "key": "sortBy", "value": "title" },
                { "key": "direction", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Get Books by Author",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/author/{{authorId}}?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "author", "{{authorId}}"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Clean Code - Updated Edition\",\n  \"isbn\": \"9780132350884\",\n  \"description\": \"Revised edition of agile craftsmanship.\",\n  \"price\": 44.99,\n  \"publishedDate\": \"2008-08-01\",\n  \"genre\": \"Software Engineering\",\n  \"stockQuantity\": 60,\n  \"authorId\": {{authorId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}"]
            }
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "{{bookId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Error Scenarios",
      "item": [
        {
          "name": "Invalid Input Validation Test (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"isbn\": \"invalid-isbn\",\n  \"price\": -10.00,\n  \"stockQuantity\": -5,\n  \"authorId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "Duplicate ISBN Test (409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Duplicate Book\",\n  \"isbn\": \"9780132350884\",\n  \"price\": 29.99,\n  \"stockQuantity\": 10,\n  \"authorId\": {{authorId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/books",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books"]
            }
          }
        },
        {
          "name": "Resource Not Found Test (404 Not Found)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/books/99999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "books", "99999"]
            }
          }
        }
      ]
    }
  ]
}
